# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — values live in the Vercel dashboard, never in git
.env
.env*.local
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# QA test artifacts — never commit (these live in the parent folder; rule is a safety net)
QA-*.html
*-SCRUM-*.html
qa-demo-media/

# Local feature demos, guides and reports — built and viewed on the dev machine,
# never part of the app.
/features-*.html
/*-report.html
/*-guide.html
/*-guide.pdf
/*.pdf

# end-to-end tests
/e2e-report/
/test-results/
/playwright-report/
.env.e2e

# Test sheets, reports, guides and any generated document — these are written and
# read on the dev machine only and must never reach the repository.
/features-*.html
/*-report.html
/*-guide.html
/*TEST*.html
/*-SCRUM-*.html
/QA-*.html
/*.pdf
qa-shots/

# Generated reports, guides, walkthroughs, invoices, proposals and proof screenshots.
# Built and read on the dev machine only; they must never reach GitHub or Vercel.
# Root-anchored on purpose: public/ holds real site images (public/email/*.png is
# used by the emails) and the backend deploys from the committed dist/, so an
# unanchored *.png or *.pdf rule would break the site.
/*.html
/*.pdf
/*.png
/*.jpg
/*.jpeg
/*.docx
/*.xlsx
/*.csv
qa-shots/
qa-evidence/
qa-regression/
figma-refs/
